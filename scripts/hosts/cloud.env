# cloud（<CLOUD1_PUBLIC_IP>，宁夏中卫 IDC）：2×RTX 4090 24G，单机跑 控制面+渲染节点+合成，数据放 500G 云盘 /data（vdb，ext4，fstab LABEL=data；docker data-root 也在 /data/docker）
# 公网机：GitHub 不通（OpenTalking 源码/nanovllm/flash_attn 由 205 经本地中转），HF 镜像/ModelScope/阿里 pypi 可用
SSH=ubuntu@<CLOUD1_PUBLIC_IP>
TALK_HOME=/data/talk
TTS_HOME=/data/tts
PUBLIC_HOST=<CLOUD1_PUBLIC_IP>
# 分卡同 205：GPU1 渲染（一个 OpenTalking 实例），GPU0 合成 + 网关识别
TALK_GPU=0,1
TTS_GPU=0
OPENTALKING_TORCH_DEVICE=cuda:1
OPENTALKING_QUICKTALK_DEVICE=cuda:1
OPENTALKING_STT_SENSEVOICE_DEVICE=cuda:1
GATEWAY_ASR_DEVICE=cuda:0
VOX_DTYPE=bfloat16
VOX_ATTN=
VOX_GPU_MEM=0.5
# 4090 估算单卡 9 在线（方案文档口径），未压测前先按 3090 的 6 取保守值，loadtest 后再调
OT_MAX_SESSIONS_PER_INSTANCE=3
# 集群（2026-10-22 起和 cloud2 组双机：本机主控制面，cloud2 备控制面；渲染/合成跨机分流）
# 控制面地址用公网（节点心跳走公网 8443，安全组已开；连自己走 hairpin）；节点间、合成池走内网 IP（8301/8302 不对公网开）
NODE_ID=cloud
DEPLOY_SERVICES="control talk tts"
CONTROL_URLS=https://<CLOUD1_PUBLIC_IP>:8443,https://<CLOUD2_PUBLIC_IP>:8443
NODE_URL=http://<CLOUD1_LAN_IP>:8301
LOCAL_TTS_URLS=http://127.0.0.1:8302,http://<CLOUD2_LAN_IP>:8302
LOCAL_TTS_MAX=32
# 公网 WebRTC：机器只有内网 IP（<CLOUD1_LAN_IP>，EIP 1:1 NAT），aiortc 要靠 STUN 拿到公网候选；google 的 STUN 国内浏览器连不上，用小米/B站的
OPENTALKING_WEBRTC_STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478
# 机器自己连自己的公网 IP 会超时（NAT 不回环）：宿主机加了 iptables nat OUTPUT DNAT <CLOUD1_PUBLIC_IP>→<CLOUD1_LAN_IP>（systemd talk-hairpin.service 开机恢复）
# 这台机专用 MiniMax key（2026-10-22 用户给的新 key，sk-api- 格式；覆盖 grader/.env 里的旧 JWT key）
MINIMAX_API_KEY=sk-api-1MkPMN1TM_XEzIaGkZLY6LJxJ4lj600EhY4Yweb5ehqmQ1cB6jsTaJ9XXTcdUuZkXjGhtrcCnYGfiD8_4Pr6HsUjoiYY36sx9EV8DOx2pA58HZRmKFb7o3M
VOX_STYLE_MODE=ultimate
# 评估中的渲染服务（2026-10-22）：SERVICES="flashhead" / "omnirt" 单独部署；FlashHead 和 tts 共用 GPU0，OmniRT 和渲染共用 GPU1
FLASHHEAD_HOME=/data/flashhead
FLASHHEAD_GPU=0
OMNIRT_HOME=/data/omnirt
OMNIRT_GPU=1
# 渲染模型评估（2026-10-22）：本机有 FlashHead 推理服务（talk-flashhead :8766），cloud2 没有 → 只有本机报 flashhead，控制面按模型分流
NODE_MODELS=quicktalk
RENDER_MODELS=quicktalk
OPENTALKING_FLASHHEAD_BACKEND=direct_ws
OPENTALKING_FLASHHEAD_WS_URL=ws://127.0.0.1:8766/v1/avatar/realtime
OPENTALKING_FLASHHEAD_ENABLED=1
OPENTALKING_FLASHHEAD_WIDTH=512
OPENTALKING_FLASHHEAD_HEIGHT=512

# 一张卡多客户多形象（补丁 14：形象帧不占显存，内存映射）：同时缓存 6 个形象的 worker
OPENTALKING_QUICKTALK_WORKER_CACHE_MAX=6
# 同一张渲染卡起 3 个 OpenTalking 进程（Python 单线程发音视频是瓶颈，多进程才能多路；形象帧是内存映射，进程间共享页缓存）
OT_GPUS=1,1,1
