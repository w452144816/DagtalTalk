# 205：2×RTX 3090（GPU0 语音、GPU1 渲染），数据只能放 /mnt/hdd-16t/wwang
SSH=wwang@<GPU1_LAN_IP>
TALK_HOME=/mnt/hdd-16t/wwang/talk
TTS_HOME=/mnt/hdd-16t/wwang/tts
PUBLIC_HOST=<GPU1_LAN_IP>
TALK_GPU=0,1
TTS_GPU=0
OPENTALKING_TORCH_DEVICE=cuda:1
OPENTALKING_QUICKTALK_DEVICE=cuda:1
OPENTALKING_STT_SENSEVOICE_DEVICE=cuda:1
GATEWAY_ASR_DEVICE=cuda:0
VOX_DTYPE=bfloat16
VOX_ATTN=
VOX_GPU_MEM=0.5
# 每张渲染卡最多同时在线：3090 有待机会话时稳定 3 路说话（单独 4 路）× 2，说话约占 30%（2026-10-17 实测）
OT_MAX_SESSIONS_PER_INSTANCE=6
# 多机：205 跑控制面 + 渲染节点 + 合成
NODE_ID=205
DEPLOY_SERVICES="control talk tts"
# 合成池：本机优先，满了用 206 的（3090 单卡 32 路并发）
LOCAL_TTS_URLS=http://127.0.0.1:8302,http://<GPU2_LAN_IP>:8302
LOCAL_TTS_MAX=32
