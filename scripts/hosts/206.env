# 206（titan-x10）：8×TITAN V（Volta sm70，GPU0 32G 是 wehu 的服务，别用；GPU1~7 各 12G），数据放 /home/wwang
# 分工（2026-10-16 实测）：单张 TITAN V 渲染稳 2 路、合成 4 路（RTF 0.45）
#   渲染 GPU1,2,4,5,6（5 个 OpenTalking 实例 → 同时说话 10 路），合成 GPU3,7（8 路并发，够 ~16 路说话用）
SSH=wwang@<GPU2_LAN_IP>
TALK_HOME=/home/wwang/talk
TTS_HOME=/home/wwang/tts
PUBLIC_HOST=<GPU2_LAN_IP>
# talk 容器看 GPU1,2,4,5,6（容器内 0~4），每张一个渲染实例；网关识别跟第一个实例同卡（很轻）
TALK_GPU=1,2,4,5,6
OT_GPUS=0,1,2,3,4
OPENTALKING_TORCH_DEVICE=cuda:0
OPENTALKING_QUICKTALK_DEVICE=cuda:0
OPENTALKING_STT_SENSEVOICE_DEVICE=cuda:0
GATEWAY_ASR_DEVICE=cuda:0
# 合成：GPU3、GPU7 各一份模型（容器内 0、1）
TTS_GPU=3,7
VOX_DEVICES=0,1
# Volta 没有 flash-attn（走 SDPA）、没有 bf16 硬件（bf16 模拟慢到 RTF 1.4）→ fp16。
# fp16 要靠 tts/patch_volta.py 的两处修正：残差流留 fp32、无残差 RMSNorm 用 fp32 算，否则输出满幅噪声停不下来
VOX_DTYPE=float16
VOX_ATTN=sdpa
VOX_NO_COMPILE=0
VOX_EAGER=0
# 12G 卡：单卡 4 路（8 路捕获 CUDA graph 时 OOM）；KV 手动给 48 块（自动估算是负的）
VOX_GPU_MEM=0.62
VOX_MAX_SEQS=4
VOX_MAX_BATCHED_TOKENS=4096
VOX_KV_BLOCKS=48
# SDPA 版 decode 在 CUDA graph 里按最大长度 gather，长度减半省显存；单句生成步数相应限到 1200
VOX_MAX_MODEL_LEN=2048
VOX_MAX_GEN=1200
# 每张渲染卡最多同时在线：TITAN V 单独稳定 2 路说话，有待机会话时按 1.5 路 × 2 保守取 3
OT_MAX_SESSIONS_PER_INSTANCE=3
# 多机：206 只跑渲染节点 + 合成（控制面在 205）
NODE_ID=206
DEPLOY_SERVICES="control talk tts"
# 合成池：本机优先（两张 TITAN V 各 4 路 = 8），满了用 205 的 3090
LOCAL_TTS_URLS=http://127.0.0.1:8302,http://<GPU1_LAN_IP>:8302
LOCAL_TTS_MAX=8
