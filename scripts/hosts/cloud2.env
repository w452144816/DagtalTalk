# cloud2（<CLOUD2_PUBLIC_IP>，内网 <CLOUD2_LAN_IP>，和 cloud 同机房）：1×RTX 3090 24G，单机跑 控制面+渲染节点+合成，数据放 100G 云盘 /data
# 单卡：渲染和合成只能同卡（会互相拖，在线上限按低了取）；大文件都从 cloud 内网直传（scripts/bootstrap.sh --from）
SSH=ubuntu@<CLOUD2_PUBLIC_IP>
TALK_HOME=/data/talk
TTS_HOME=/data/tts
PUBLIC_HOST=<CLOUD2_PUBLIC_IP>
TALK_GPU=0
TTS_GPU=0
OPENTALKING_TORCH_DEVICE=cuda:0
OPENTALKING_QUICKTALK_DEVICE=cuda:0
OPENTALKING_STT_SENSEVOICE_DEVICE=cuda:0
GATEWAY_ASR_DEVICE=cuda:0
VOX_DTYPE=bfloat16
VOX_ATTN=
# 和渲染同卡（渲染约 7G）：合成预算 0.45×24G，KV 块手动给 48（自动估算会是负数，容器反复重启），并发 4
VOX_GPU_MEM=0.45
VOX_MAX_SEQS=4
VOX_MAX_BATCHED_TOKENS=4096
VOX_KV_BLOCKS=48
VOX_MAX_MODEL_LEN=2048
VOX_MAX_GEN=1200
OT_MAX_SESSIONS_PER_INSTANCE=3
# 集群：cloud 主控制面、本机备控制面（CONTROL_URLS 顺序决定主备）；节点间/合成池走内网 IP
NODE_ID=cloud2
DEPLOY_SERVICES="control talk tts"
CONTROL_URLS=https://<CLOUD1_PUBLIC_IP>:8443,https://<CLOUD2_PUBLIC_IP>:8443
NODE_URL=http://<CLOUD2_LAN_IP>:8301
LOCAL_TTS_URLS=http://127.0.0.1:8302,http://<CLOUD1_LAN_IP>:8302
LOCAL_TTS_MAX=8
OPENTALKING_WEBRTC_STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478
VOX_STYLE_MODE=ultimate
MINIMAX_API_KEY=sk-api-1MkPMN1TM_XEzIaGkZLY6LJxJ4lj600EhY4Yweb5ehqmQ1cB6jsTaJ9XXTcdUuZkXjGhtrcCnYGfiD8_4Pr6HsUjoiYY36sx9EV8DOx2pA58HZRmKFb7o3M
RENDER_MODELS=quicktalk
