# ---- 网关 / LLM（key 由 scripts/deploy.sh 从 ../grader/.env、../hz/1/.env 读取后写入服务器 .env）----
PUBLIC_HOST=<GPU1_LAN_IP>
GATEWAY_PORT=8443
GATEWAY_LOCAL_PORT=8301
# ---- 多机（scripts/hosts/cluster.env 覆盖）：节点向 CONTROL_URL 心跳，/internal/* 用 NODE_TOKEN 鉴权 ----
CONTROL_URLS=
NODE_TOKEN=
NODE_ID=
LLM_DEFAULT=ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=doubao-seed-2-0-mini-260215
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3
BASE_AVATAR=office-woman
AVATAR_MODEL=quicktalk

# ---- OpenTalking ----
OPENTALKING_API_HOST=127.0.0.1
OPENTALKING_API_PORT=8000
OPENTALKING_UNIFIED_HOST=127.0.0.1
OPENTALKING_UNIFIED_PORT=8000
OPENTALKING_AVATARS_DIR=/w/avatars
OPENTALKING_DEFAULT_MODEL=quicktalk
OPENTALKING_QUICKTALK_BACKEND=local
# 双卡：OpenTalking 渲染在 cuda:1（GPU1）；网关识别 + 本地合成（talk-tts 容器）在 GPU0
OPENTALKING_TORCH_DEVICE=cuda:1
OPENTALKING_QUICKTALK_DEVICE=cuda:1
GATEWAY_ASR_DEVICE=cuda:0
# 本地合成服务：clone_ / vox_ 音色走这里（不配则克隆退回网关进程内的 Qwen3-TTS 单路）
LOCAL_TTS_URL=http://127.0.0.1:8302
OPENTALKING_MODEL_ROOT=/w/models
OPENTALKING_QUICKTALK_ASSET_ROOT=/w/models/quicktalk
OPENTALKING_QUICKTALK_WORKER_CACHE=1
# 底板正向循环（动态形象底板首尾已交叉淡化成无缝循环；默认的正放/倒放往返会让手势"倒带"）
OPENTALKING_QUICKTALK_TEMPLATE_LOOP=wrap
OMNIRT_ENDPOINT=
OPENTALKING_OMNIRT_ENDPOINT=
OPENTALKING_LLM_BASE_URL=http://127.0.0.1:8301/v1
OPENTALKING_LLM_API_KEY=local
OPENTALKING_LLM_MODEL=router
# 语音合成全部走网关 /v1/audio/speech（MiniMax 系统/克隆音色，edge 音色 ID 则转 edge），见 gateway/tts.py
OPENTALKING_TTS_DEFAULT_PROVIDER=openai_compatible
OPENTALKING_TTS_PROVIDER=openai_compatible
OPENTALKING_TTS_OPENAI_BASE_URL=http://127.0.0.1:8301/v1
OPENTALKING_TTS_OPENAI_API_KEY=local
OPENTALKING_TTS_OPENAI_MODEL=speech-2.8-turbo
OPENTALKING_TTS_OPENAI_RESPONSE_FORMAT=pcm
OPENTALKING_TTS_OPENAI_VOICE=vox_f_gentle
OPENTALKING_TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
OPENTALKING_TTS_STREAMING_DECODE=1
OPENTALKING_TTS_SAMPLE_RATE=16000
OPENTALKING_STT_DEFAULT_PROVIDER=sensevoice
OPENTALKING_STT_ENABLED_PROVIDERS=sensevoice
OPENTALKING_STT_PROVIDER=sensevoice
OPENTALKING_STT_SENSEVOICE_MODEL_DIR=/w/models/local-audio/iic__SenseVoiceSmall
OPENTALKING_STT_SENSEVOICE_DEVICE=cuda:1
OPENTALKING_FFMPEG_BIN=ffmpeg
# 人设（页面可覆盖）；要求首句短、用句号断句，好让第一句尽早进 TTS
OPENTALKING_LLM_SYSTEM_PROMPT=你是一个正在和用户视频通话的数字人。用口语化的中文简短回答，每次一到三句话，像真人聊天一样自然，不要列清单。第一句话要短，并用句号、问号或感叹号断句。
SYSTEM_PROMPT=你是一个正在和用户视频通话的数字人。用口语化的中文简短回答，每次一到三句话，像真人聊天一样自然，不要列清单。第一句话要短，并用句号、问号或感叹号断句。
# 少于这么多字的开头先攒着再送 TTS（默认 6，"你好呀！"会被扣住）
FLASHTALK_TTS_COALESCE_MIN_CHARS=4
AI_SERVICE_KEY=
